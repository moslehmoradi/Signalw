<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="24dp"
    android:layoutDirection="rtl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="وضعیت لحظه‌ای آنتن‌دهی و قدرت سیگنال اینترنت سیم‌کارت"
        android:textColor="#475569"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_diagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:text="در حال خواندن اطلاعات سیم‌کارت..."
        android:textColor="#0F172A"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btn_request_permissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="بررسی و اعطای مجوز سیم‌کارت" />

    <Button
        android:id="@+id/btn_pin_widget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="افزودن ویجت به صفحه اصلی گوشی" />

    <Button
        android:id="@+id/btn_toggle_service"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="فعال‌سازی بروزرسانی زنده ویجت" />

</LinearLayout>
