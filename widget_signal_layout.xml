<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp"
    android:layoutDirection="rtl">

    <!-- ردیف بالایی: نام اپراتور، نوع شبکه و دکمه بروزرسانی -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_operator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ایرانسل"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_network_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:text="4G+"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="بروزرسانی سیگنال"
            android:src="@android:drawable/ic_popup_sync"
            android:tint="#94A3B8" />
    </LinearLayout>

    <!-- ردیف میانی: مقدار dBm و میله‌های گرافیکی قدرت سیگنال -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_dbm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="-84 dBm"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عالی · ASU 54"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ۵ میله مدرج قدرت سیگنال -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:layoutDirection="ltr">

            <View
                android:id="@+id/bar_1"
                android:layout_width="5dp"
                android:layout_height="8dp"
                android:layout_marginEnd="3dp"
                android:background="#10B981" />

            <View
                android:id="@+id/bar_2"
                android:layout_width="5dp"
                android:layout_height="13dp"
                android:layout_marginEnd="3dp"
                android:background="#10B981" />

            <View
                android:id="@+id/bar_3"
                android:layout_width="5dp"
                android:layout_height="18dp"
                android:layout_marginEnd="3dp"
                android:background="#10B981" />

            <View
                android:id="@+id/bar_4"
                android:layout_width="5dp"
                android:layout_height="23dp"
                android:layout_marginEnd="3dp"
                android:background="#10B981" />

            <View
                android:id="@+id/bar_5"
                android:layout_width="5dp"
                android:layout_height="28dp"
                android:background="#2A364F" />
        </LinearLayout>
    </LinearLayout>

    <!-- ردیف سیم‌کارت دوم (اختیاری) -->
    <LinearLayout
        android:id="@+id/sim2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="visible">

        <TextView
            android:id="@+id/tv_sim2_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="همراه اول: -96 dBm (LTE)"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
